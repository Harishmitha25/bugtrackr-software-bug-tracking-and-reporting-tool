# MongoDB Atlas connection string
MONGO_URI=

# Secret used to sign JWTs
JWT_SECRET=

# Gmail (or other SMTP) credentials used to send OTP/notification emails
EMAIL_USER=
EMAIL_PASS=

# Token used by the internal cron jobs to call this backend's own auto-assign endpoints
ADMIN_TOKEN=

# Shared secret the duplicate-detection-service must send to call protected backend endpoints
SIMILARITY_API_KEY=

# Deployed frontend URL (used for Socket.io CORS and links in emails)
FRONTEND_URL=https://localhost:3000

# This backend's own public URL (used by cron jobs / routes that call the backend's own API)
BACKEND_URL=https://localhost:5000

# Deployed duplicate-detection-service URL
ML_SERVICE_URL=http://localhost:8000

# Port to listen on (most hosting platforms set this automatically)
PORT=5000
